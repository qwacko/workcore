{
  "name": "workcore-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev.mjs",
    "deploy": "pnpm build && wrangler deploy --env=\"\"",
    "build": "pnpm build:ui && wrangler deploy --env=\"\" --dry-run --outdir dist",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate && node scripts/ingest-migrations.mjs",
    "dev:ui": "vite dev",
    "build:ui": "pnpm --filter @workcore/admin build && vite build && node scripts/copy-admin.mjs"
  },
  "dependencies": {
    "@workcore/admin": "workspace:*",
    "@workcore/ai": "workspace:*",
    "@workcore/client": "workspace:*",
    "@workcore/core": "workspace:*",
    "@workcore/files": "workspace:*",
    "@workcore/saved-displays": "workspace:*",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "vite": "^8.3.5",
    "typescript": "^6.0.2"
  }
}
