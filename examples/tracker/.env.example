# pnpm dev reads root .env, then this folder's .env. Shell variables take precedence.
HOST=127.0.0.1
PORT=8787
# Comma-separated exact hostnames, without https:// or ports.
# Only use proxy hosts protected by access controls: this is an unauthenticated demo.
DEMO_ALLOWED_HOSTS=localhost

# Model IDs use provider/model; OpenRouter models contain another slash.
# Unset WORKCORE_AGENT_MODEL (or set WORKCORE_AI_MODE=demo) for offline demo responses.
# WORKCORE_AI_MODE=model
# WORKCORE_AGENT_MODEL=openrouter/anthropic/claude-sonnet-4.5
# A backup is optional; it needs its own provider's key (unless sharing a provider).
# WORKCORE_AGENT_FALLBACK_MODEL=openai/gpt-4.1-mini
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENCODE_API_KEY=

# Restart pnpm dev after changing these settings. Never use VITE_ prefixes for keys.
