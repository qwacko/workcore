{
  "name": "@workcore/example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev.mjs",
    "deploy": "wrangler deploy --env=''",
    "build": "wrangler deploy --env='' --dry-run --outdir dist",
