{
  "name": "workcore",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "pnpm --filter @workcore/example dev",
    "deploy": "pnpm --filter @workcore/example deploy",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^24.7.0",
    "@playwright/test": "^1.64.0",
    "typescript": "7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.152.0",
    "zod": "^4.6.7"
  }
}
