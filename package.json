{
  "name": "workcore",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "test": "pnpm --filter workcore-demo build:ui && node --test scripts/*.test.mjs && vitest run",
    "test:e2e": "pnpm --filter workcore-demo build:ui && playwright test",
    "test:packages": "pnpm --filter './packages/*' build && node scripts/package-smoke.mjs",
    "dev": "pnpm --filter workcore-demo dev",
    "deploy": "pnpm --filter workcore-demo run deploy",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.7.0",
    "ai": "^7.0.153",
    "drizzle-orm": "^0.45.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.152.0",
    "zod": "^4.6.7"
  }
}
