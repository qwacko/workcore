{
  "name": "@workcore/adapters",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./redis": { "types": "./dist/redis/index.d.ts", "import": "./dist/redis/index.js" },
    "./postgres": { "types": "./dist/postgres/index.d.ts", "import": "./dist/postgres/index.js" },
    "./file": { "types": "./dist/file/index.d.ts", "import": "./dist/file/index.js" },
    "./memory": { "types": "./dist/memory/index.d.ts", "import": "./dist/memory/index.js" }
  },
  "files": ["dist/file", "dist/memory", "dist/postgres", "dist/redis"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "vitest run", "test:integration": "vitest run src/integration.test.ts" },
  "dependencies": { "@workcore/core": "workspace:*" },
  "peerDependencies": { "pg": ">=8", "redis": ">=4" },
  "peerDependenciesMeta": { "pg": { "optional": true }, "redis": { "optional": true } },
  "devDependencies": { "@types/node": "^24.7.0", "@types/pg": "^8.15.5", "pg": "^8.16.3", "redis": "^5.8.2", "vitest": "^3.2.4" }
