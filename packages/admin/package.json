{
  "name": "@workcore/admin",
  "version": "0.1.1",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/qwacko/workcore.git", "directory": "packages/admin" },
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./assets": "./scripts/assets.mjs"
  },
  "files": ["dist", "build", "scripts/assets.mjs", "LICENSE", "README.md"],
  "publishConfig": { "access": "public", "exports": { "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" }, "./assets": "./scripts/assets.mjs" } },
  "scripts": {
    "build": "vite build --logLevel warn && tsc -p tsconfig.server.json",
    "dev": "vite dev",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@lucide/svelte": "^1.68.0",
    "@shadcn-svelte/primitives": "^0.0.1",
    "@workcore/client": "workspace:*",
    "@workcore/core": "workspace:*",
    "bits-ui": "^2.20.4",
    "cn": "^0.5.2",
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "shadcn-svelte": "^1.8.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.2",
    "vite": "^8.3.5"
  }
}
